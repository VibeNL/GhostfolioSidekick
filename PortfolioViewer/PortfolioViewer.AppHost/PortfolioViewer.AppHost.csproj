<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAspireHost>true</IsAspireHost>
		<!-- Aspire 17 mandates the CLI bundle (ASPIRE013 is not suppressible); dnxpinned keeps the CLI NuGet-restored via the SDK dnx host instead of an installed aspire command -->
		<AspireUseCliBundle>true</AspireUseCliBundle>
		<AspireCliInvocationMode>dnxpinned</AspireCliInvocationMode>
		<UserSecretsId>0e39bd1b-92a1-40c4-9a12-5e743e8b5a3b</UserSecretsId>
		<AssemblyName>GhostfolioSidekick.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>GhostfolioSidekick.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<SonarQubeSetting Include="sonar.exclusions">
			<Value>**/*.js</Value>
		</SonarQubeSetting>
		<SonarQubeSetting Include="sonar.coverage.exclusions">
			<Value>**</Value>
		</SonarQubeSetting>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting.AppHost" />
		<PackageReference Include="Aspire.Hosting.Blazor" />
		<PackageReference Include="Aspire.Hosting.Dotnet" />
		<PackageReference Include="Grpc.AspNetCore" />
		<PackageReference Include="Grpc.Net.Client" />
		<PackageReference Include="Grpc.Tools" />
		<!-- Pin transitive MessagePack to patched version (GHSA-qhrr-8q5h-9q3h) -->
		<PackageReference Include="MessagePack" />
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
	</ItemGroup>

</Project>
